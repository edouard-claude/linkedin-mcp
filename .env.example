# Origine publique HTTPS du serveur. C'est l'émetteur OAuth et la base de
# toutes les URL qu'il distribue : elle doit correspondre exactement à ce qui
# est déclaré côté LinkedIn.
PUBLIC_URL=https://linkedin-mcp.example.com

# Onglet Auth de l'application LinkedIn.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# 32 octets en base64 chacune : openssl rand -base64 32
# TOKEN_CIPHER_KEY chiffre les jetons LinkedIn au repos, JWT_SIGNING_KEY signe
# les jetons d'accès remis aux clients MCP.
TOKEN_CIPHER_KEY=
JWT_SIGNING_KEY=

# Facultatif à partir d'ici.

# Version de l'API LinkedIn (en-tête LinkedIn-Version), au format YYYYMM.
#LINKEDIN_API_VERSION=202606

# Permissions demandées au membre. Ajouter r_member_social et
# r_member_postAnalytics une fois Community Management accordé.
#LINKEDIN_SCOPES=openid profile email w_member_social w_member_social_feed

# Identifiants de membres LinkedIn autorisés, séparés par des virgules.
# Vide : tout le monde peut se connecter.
#ALLOWED_MEMBER_IDS=

#DB_PATH=/data/linkedin.db
#LISTEN_ADDR=:8080
#ACCESS_TOKEN_TTL=1h
#REFRESH_TOKEN_TTL=720h
#LOG_FORMAT=json

# Relaie /relay/callback vers 127.0.0.1:<port>, pour les clients MCP locaux
# qui écoutent sur la boucle locale.
#LOOPBACK_RELAY_PORT=
